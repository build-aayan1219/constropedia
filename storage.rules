rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Article images: readable by everyone, write-restricted
    match /article_images/{image} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule: users can manage their own files if stored under users/{userId}
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
